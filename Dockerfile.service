# Multi-purpose lightweight service container for SealArena
FROM python:3.12-slim

# Prevent python from writing pyc files and buffering stdout
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

# Install system dependencies (curl for healthchecks, iproute2/iptables for network inspection)
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    iproute2 \
    iptables \
    net-tools \
    dnsutils \
    && rm -rf /var/lib/apt/lists/*

# Install python dependencies
RUN pip install --no-cache-dir \
    fastapi==0.115.0 \
    uvicorn==0.31.0 \
    pydantic==2.9.2 \
    cryptography==43.0.1 \
    httpx==0.27.2 \
    numpy==2.1.1 \
    scikit-learn==1.5.2

# Create non-root tenant user
RUN groupadd -g 1000 sealgroup && \
    useradd -u 1000 -g sealgroup -s /bin/bash -m sealuser

# Copy application source, configs, certs, and data
COPY src /app/src
COPY configs /app/configs
COPY certs /app/certs
COPY data /app/data
COPY cli /app/cli
COPY leaktest /app/leaktest

# Set ownership
RUN chown -R sealuser:sealgroup /app

# Switch to non-root user
USER 1000:1000

ENV PYTHONPATH=/app

CMD ["python", "-m", "src.arbiter.main"]
